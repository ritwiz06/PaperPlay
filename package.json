{
  "name": "paperplay",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Turns a research paper into a playable, explorable world.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "npm run dev --workspace @paperplay/web",
    "dev:api": "npm run dev --workspace @paperplay/api",
    "build": "npm run build --workspace @paperplay/web && node scripts/check-bundle.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tests/e2e/tsconfig.json && npm run typecheck --workspaces",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:gate": "node scripts/check-gate.ts",
    "check:docs": "node scripts/check-docs.ts",
    "land": "node scripts/land.ts",
    "sweep:defaults": "node scripts/sweep-defaults.ts",
    "choose:hook-seed": "node scripts/hook-seed.ts",
    "sweep:groups": "node scripts/group-measure.ts",
    "sweep:levels": "node scripts/levels.ts",
    "fixture:threshold-town": "node scripts/threshold-town.ts",
    "fixture:momentum": "node scripts/momentum.ts",
    "library": "node scripts/library.ts",
    "library:thumbnails": "node scripts/library-thumbnails.ts",
    "sources:map": "node scripts/source-map.ts map",
    "sources:check": "node scripts/source-map.ts check",
    "pipeline:live": "node scripts/pipeline-live.ts",
    "ingest": "node scripts/ingest.ts",
    "routing-set": "node scripts/routing-set.ts",
    "capture:demo": "node scripts/capture-demo.ts",
    "prepare": "node scripts/hooks/install.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
