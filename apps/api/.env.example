# The gateway: an OpenAI-compatible endpoint's address, and its key (ADR-0030, ADR-0052).
VOYAGER_BASE_URL=
VOYAGER_API_KEY=
# Optional, unset by default (ADR-0039): an address sent only to the APIs that ask for a contact,
# NCBI's E-utilities and arXiv. Unset, no request carries one.
PAPERPLAY_CONTACT_EMAIL=
