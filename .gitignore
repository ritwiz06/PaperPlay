# Dependencies and build output
node_modules/
dist/
*.tsbuildinfo
.vite/

# Test evidence is regenerated by every run; check:gate deletes stale reports first
reports/
test-results/
playwright-report/
blob-report/
coverage/

# Demo videos from npm run capture:demo; regenerated, never committed
captures/

# Jobs the local API ran: their events and artifacts, regenerated by each run
apps/api/data/

# Secrets live in apps/api/.env only and are never committed
.env
.env.*
!.env.example

.DS_Store

# Owner-only reference material, such as the project handbook; never committed (ADR-0006)
reference/private/

# Claude Code agent worktrees: full copies of the repository
.claude/worktrees/

# The miniature's Python environment (ADR-0057); its weights are committed, the environment is not.
training/.venv/
training/__pycache__/
