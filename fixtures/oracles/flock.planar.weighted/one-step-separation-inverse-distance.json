{
  "oracle": "oracle/1",
  "id": "flock.one-step.separation-inverse-distance",
  "primitive": { "id": "flock.planar.weighted", "version": "1.0.0" },
  "basis": "derived",
  "kind": "one-step",
  "claim": "Separation weighs each crowding neighbour by the inverse of its distance, so the closest bird dominates the escape direction.",
  "derivation": [
    "Only separation is on (w_s = 1). A (10, 10), B (11, 10) and C (10, 10.5) all move at (0, 1); every pair is closer than R_s = 1.55 (|AB| = 1, |AC| = 0.5, |BC| = √1.25 ≈ 1.118).",
    "Each neighbour contributes −δ/|δ|², a push of size 1/|δ| (E5): s_A = −(1, 0)/1 − (0, 0.5)/0.25 = (−1, −2), so the nearer bird C dominates.",
    "s_B = −(−1, 0)/1 − (−1, 0.5)/1.25 = (1.8, −0.4); s_C = −(0, −0.5)/0.25 − (1, −0.5)/1.25 = (−0.8, 2.4).",
    "S = 2.7 · s/|s| − (0, 1): S_A = (−1.207477, −3.414953), S_B = (2.635705, −1.585712), S_C = (−0.853815, 1.561445); none exceeds a_max = 50 (E8).",
    "v′ = (0, 1) + S Δt with every speed inside [0.45, 3.6], and p′ = p + v′ Δt (E9, E10)."
  ],
  "params": {
    "agentCount": 3, "worldWidth": 32, "worldHeight": 32,
    "separationWeight": 1, "alignmentWeight": 0, "cohesionWeight": 0,
    "perceptionRadius": 4.5, "separationRadius": 1.55,
    "targetSpeed": 2.7, "minSpeed": 0.45, "maxSpeed": 3.6, "maxAcceleration": 50,
    "beaconWeight": 0, "obstacleWeight": 0, "obstacleRadius": 3.4
  },
