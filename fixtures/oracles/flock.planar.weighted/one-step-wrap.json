    "agentCount": 3, "worldWidth": 20, "worldHeight": 20,
    "separationWeight": 0, "alignmentWeight": 0, "cohesionWeight": 0,
    "perceptionRadius": 4.5, "separationRadius": 1.55,
    "targetSpeed": 2.7, "minSpeed": 0.45, "maxSpeed": 3.6, "maxAcceleration": 50,
    "beaconWeight": 0, "obstacleWeight": 0, "obstacleRadius": 3.4
  },
  "dt": 0.016666666666666666,
  "state": {
    "width": 20, "height": 20, "stepIndex": 0,
    "agents": [
      { "x": 19.99, "y": 5, "vx": 3, "vy": 0 },
